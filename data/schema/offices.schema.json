{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MoG World / Offices model",
  "type": "object",
  "required": ["world", "biomes", "offices"],
  "properties": {
    "$schema": { "type": "string" },
    "world": {
      "type": "object",
      "required": ["name", "capital"],
      "properties": {
        "name": { "type": "string" },
        "motto": { "type": "string" },
        "capital": { "type": "string" },
        "source_map": { "type": "string" }
      }
    },
    "biomes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "terrain"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "name": { "type": "string" },
          "terrain": { "type": "string" },
          "region": { "type": "string" },
          "palette": { "type": "string", "enum": ["cold", "neutral", "warm", "hot"] }
        }
      }
    },
    "offices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "location", "office", "role", "tier", "biome", "structure"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "location": { "type": "string" },
          "office": { "type": "string" },
          "role": { "type": "string" },
          "tier": {
            "type": "string",
            "enum": ["capital", "sub_capital", "major_office", "service_secretariat", "outpost"]
          },
          "biome": { "type": "string" },
          "structure": { "type": "string" },
          "map_position": {
            "type": "object",
            "required": ["x", "y"],
            "properties": {
              "x": { "type": "number", "minimum": 0, "maximum": 1 },
              "y": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
